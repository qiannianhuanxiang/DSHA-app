<?xml version='1.0' encoding='utf-8'?>
<!-- 插件卡片（UI v5）：名称/说明/状态在同一个 surface 卡片里，开关与操作保持真实绑定。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_shell_card" android:orientation="vertical" android:padding="@dimen/shell_card_pad">
    <TextView android:id="@+id/pluginName" android:layout_width="match_parent" android:layout_height="wrap_content" android:breakStrategy="simple" android:fontFamily="sans" android:includeFontPadding="false" android:textColor="@color/shell_text" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/pluginDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="6dp" android:lineSpacingExtra="2dp" android:maxLines="3" android:textColor="@color/shell_text_secondary" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/pluginStatus" style="@style/ShellStatusText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/pluginSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:showText="false" />
        <TextView android:id="@+id/pluginActions" style="@style/ShellTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:background="@drawable/bg_shell_pill" android:minHeight="44dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/ui_m0146" />
    </LinearLayout>
    <Button android:id="@+id/pluginExpand" style="@style/ShellTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" />
    <TextView android:id="@+id/pluginDetails" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" android:visibility="gone" />
    <Button android:id="@+id/pluginDelete" style="@style/ShellTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:textColor="@color/shell_bad" android:visibility="gone" />
</LinearLayout>
