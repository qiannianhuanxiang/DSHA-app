<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/shell_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="20dp" android:paddingBottom="12dp" android:gravity="center_vertical">
        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_terminal" android:background="@drawable/bg_logo" android:padding="8dp" android:contentDescription="@null" app:tint="@color/shell_accent" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="18sp" android:textColor="@color/shell_text" android:includeFontPadding="false" android:textStyle="bold" android:layout_weight="1" android:layout_marginStart="10dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/welcome_counter" android:text="@string/ui_welcome_initial_counter" android:textSize="11sp" android:textColor="@color/text_muted" android:includeFontPadding="false" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/shell_line" />
    <androidx.viewpager2.widget.ViewPager2 android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/welcome_pager" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/welcome_dots" android:orientation="horizontal" android:gravity="start|center_vertical" android:minHeight="6dp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/welcome_btn" style="@style/ShellPrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/ui2_meet" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/welcome_skip" style="@style/ShellTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ui2_skip" />
    </LinearLayout>
</LinearLayout>
