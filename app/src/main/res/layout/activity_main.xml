<?xml version="1.0" encoding="utf-8"?>
<!--
  UI v5 手机外壳：顶栏品牌/页面语境 + 内容区 + 悬浮胶囊导航。
  底栏仍必须是 BottomNavigationView（单元测试与 debug 工具会强转），只改外观与布局；
  平板形态见 layout-sw600dp/activity_main.xml（左栏 + 隐藏底栏）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/shell_bg" android:orientation="vertical">
  <LinearLayout android:id="@+id/app_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/shell_header_min_height" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="12dp">
    <FrameLayout android:id="@+id/app_logo" android:layout_width="@dimen/shell_brand_size" android:layout_height="@dimen/shell_brand_size" android:background="@drawable/bg_shell_brand">
      <ImageView android:layout_width="@dimen/shell_brand_icon_size" android:layout_height="@dimen/shell_brand_icon_size" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_terminal" app:tint="@color/shell_accent" />
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/sub_back" android:visibility="gone" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_ui_back" android:contentDescription="@string/ui_m0201" app:tint="@color/shell_text_secondary" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:gravity="center_vertical" android:orientation="vertical">
      <TextView android:id="@+id/app_title" style="@style/DshaText.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/shell_text" android:textSize="@dimen/shell_title_text" android:letterSpacing="0.06" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
      <TextView android:id="@+id/app_context" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="@color/shell_text_secondary" android:textSize="@dimen/shell_context_text" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/btn_theme" style="@style/Widget.DSHA.ToolbarAction" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="4dp" android:padding="12dp" android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless" android:text="@string/ui_m0020" />
    <FrameLayout android:id="@+id/btn_about" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_m0067" android:visibility="gone">
      <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_about" app:tint="@color/shell_text_secondary" />
    </FrameLayout>
  </LinearLayout>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/shell_line" />
  <TextView android:id="@+id/environment_recovery_banner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="8dp" android:minHeight="44dp" android:padding="10dp" android:textColor="@color/shell_accent" android:background="@drawable/bg_chip_clickable" android:textSize="13sp" android:includeFontPadding="false" android:clickable="true" android:focusable="true" android:visibility="gone" android:gravity="center" />
  <FrameLayout android:id="@+id/fragment_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
  <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/shell_nav_margin_horizontal" android:layout_marginEnd="@dimen/shell_nav_margin_horizontal" android:layout_marginBottom="@dimen/shell_nav_margin_bottom" android:background="@drawable/bg_shell_nav" android:minHeight="@dimen/shell_nav_height" app:itemIconSize="@dimen/shell_nav_icon_size" app:itemPaddingTop="@dimen/shell_nav_item_padding_top" app:itemPaddingBottom="@dimen/shell_nav_item_padding_bottom" app:itemIconTint="@color/shell_nav_item_tint" app:itemTextColor="@color/shell_nav_item_tint" app:itemRippleColor="@color/shell_nav_ripple" app:itemTextAppearanceActive="@style/Widget.DSHA.ShellNavLabel" app:itemTextAppearanceInactive="@style/Widget.DSHA.ShellNavLabel" app:labelVisibilityMode="labeled" app:elevation="2dp" app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
