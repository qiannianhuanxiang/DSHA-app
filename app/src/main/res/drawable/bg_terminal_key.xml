<?xml version="1.0" encoding="utf-8"?>
<!-- 终端底部快捷按键的底：深色外壳上的按键块；Ctrl/Alt 一次性修饰键锁定时换成强调底色和描边。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/terminal_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/radius_small" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/terminal_accent_bg" />
                    <corners android:radius="@dimen/radius_small" />
                    <stroke android:width="@dimen/stroke" android:color="@color/terminal_accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/terminal_outline" />
                    <corners android:radius="@dimen/radius_small" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
